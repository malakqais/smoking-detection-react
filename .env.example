# Copy to .env and adjust for your deployment
SMOKEDET_SUPERVISOR_EMAIL=rayenoueslati153@gmail.com
SMOKEDET_SUPERVISOR_EMAIL_DOMAIN=@smoker.jr

# Email codes for password reset and 2FA (set a long random secret in production)
SMOKEDET_AUTH_CODE_PEPPER=change-me-to-a-long-random-string
SMOKEDET_AUTH_CODE_EXPIRY_MINUTES=10
SMOKEDET_SUPERVISOR_GRANT_TTL_MINUTES=30

# GPU inference (optional — requires CUDA PyTorch)
SMOKEDET_DEVICE=auto
# Multi-GPU: spread models across cards (person→GPU0, cigarette→GPU1, …)
# SMOKEDET_CUDA_DEVICES=0,1,2
SMOKEDET_YOLO_HALF=true
